---
extends: default

ignore: |
  .venv/
  venv/

rules:
  # Sigma rules conventionally omit the YAML document start marker.
  document-start: disable
  line-length:
    max: 140
    level: warning
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false  # GitHub Actions uses the bare key `on:`
  comments:
    min-spaces-from-content: 1
